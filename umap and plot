    "POU4F2","ATOH7","RBPMS"
  )
  
)



############################################################
## 1. 合并marker
############################################################

marker_genes <- unique(unlist(markers))


length(marker_genes)



############################################################
## 2. 检查基因是否存在
############################################################

marker_use <- marker_genes[
  marker_genes %in% rownames(obj)
]


length(marker_use)



############################################################
## 3. DotPlot提取数据
############################################################

dot_data <- DotPlot(
  
  obj,
  
  features = marker_use,
  
  group.by = "celltype_final",
  
  assay = "RNA"
  
)$data



############################################################
## 4. 整理数据
############################################################

dff <- dot_data %>%
  
  rename(
    Gene = features.plot,
    Group.x = id,
    frac_pct = pct.exp,
    mean_expr = avg.exp.scaled
  )



############################################################
## 5. 固定顺序
############################################################

dff$Group.x <- factor(
  
  dff$Group.x,
  
  levels = celltype_order
  
)


dff$Gene <- factor(
  
  dff$Gene,
  
  levels = marker_use
  
)



############################################################
## 6. 绘制气泡图
############################################################

p_dot <- ggplot(
  
  dff,
  
  aes(
    x = Gene,
    y = Group.x,
    size = frac_pct,
    color = mean_expr
  )
  
)+
  
  geom_point(
    stroke = 0
  )+
  
  scale_color_gradientn(
    
    colors = c(
      "#1F78B4",
      "#A6CEE3",
      "#FFFFFF",
      "#F4A6C1",
      "#E7298A"
    ),
    
    name = "Mean expression\nin group"
    
  )+
  
  scale_size_continuous(
    
    range = c(1,4),
    
    name = "Fraction of cells (%)"
    
  )+
  
  labs(
    x=NULL,
    y=NULL
  )+
  
  theme_test()+
  
  theme(
    
    axis.text.y =
      element_text(
        color="black",
        size=10
      ),
    
    
    axis.text.x =
      element_text(
        angle=90,
        hjust=1,
        vjust=0.5,
        face="italic",
        color="black"
      ),
    
    
    axis.ticks = element_blank(),
    
    
    legend.title =
      element_text(
        size=10
      ),
    
    
    legend.background =
      element_blank(),
    
    
    plot.margin =
      margin(
        0.5,
        0.5,
        1,
        0.5,
        unit="cm"
      )
    
  )


p_dot

ggsave(
  
