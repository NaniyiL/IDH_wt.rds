library(dplyr)
library(ggplot2)
library(ggalluvial)

# 提取 metadata
meta.data <- combined_4disease_40GBM@meta.data

# 计算四种疾病中各细胞类型的比例
prop_data <- meta.data %>%
  filter(!is.na(Disease), !is.na(L1_new)) %>%
  count(Disease, L1_new, name = "n") %>%
  group_by(Disease) %>%
  mutate(
    prop = n / sum(n) * 100
  ) %>%
  ungroup()

# 查看比例
prop_data


cell_colors <- c(
  "Tumor" = "#F29AB8",
  "Myeloid" = "#82C5E8",
  "T/NK" = "#A9D8F2",
  "Fibroblast/Mural" = "#9ED9AF",
  "Glial" = "#FFD58F",
  "Endothelial" = "#F5A49A",
  "B cell" = "#C1A9DF"
)


p_prop <- ggplot(
  prop_data,
  aes(
    x = Disease,
    y = prop,
    fill = L1_new,
    alluvium = L1_new,
    stratum = L1_new
  )
) +
  geom_col(
    position = "stack",
    width = 0.8
  ) +
  geom_alluvium(
    aes(stratum = L1_new),
    width = 0.5,
    alpha = 0.2,
    color = "white",
    linewidth = 0.8,
    curve_type = "sigmoid"
  ) +
  geom_stratum(
    width = 0.8,
    alpha = 0.7,
    color = "white"
  ) +
  scale_fill_manual(
    values = cell_colors
  ) +
  scale_y_continuous(
    expand = c(0, 0),
    limits = c(0, 100)
  ) +
  labs(
    x = NULL,
    y = "Percentage of cells",
    title = NULL,
    fill = NULL
  ) +
  theme_classic() +
  theme(
    axis.text.x = element_text(
      angle = 45,
      hjust = 1,
      size = 14,
      color = "black"
    ),
    axis.title.y = element_text(
      size = 18
    ),
    axis.text.y = element_text(
      size = 14
    ),
    legend.text = element_text(
      size = 12
    ),
    legend.title = element_text(
      size = 14
    )
  )


prop_data$Disease <- factor(
  prop_data$Disease,
  levels = c(
    "GBM",
    "BCBM",
    "NSCLC-BM",
    "Melanoma-BM"
  )
)
p_prop <- p_prop +
  scale_y_continuous(
    limits = c(0, 100),
    breaks = c(0, 25, 50, 75, 100),
    labels = function(x) paste0(x, "%"),
    expand = c(0, 0)
  )

p_prop
ggsave(
  "Figure 1D.pdf",
  plot = p_prop,
  device = cairo_pdf,
  width = 8,
  height = 10
)
