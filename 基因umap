# ==============================
# 3. 定义统一的 Marker UMAP 绘图函数
# ==============================
plot_marker_umap <- function(gene) {
  
  expr <- LayerData(
    combined_4disease_40GBM[["RNA"]],
    layer = "data"
  )[gene, ]
  
  expr <- expr[colnames(combined_4disease_40GBM)]
  
  df <- data.frame(
    UMAP_1 = umap_coord[, 1],
    UMAP_2 = umap_coord[, 2],
    Expression = as.numeric(
      expr[rownames(umap_coord)]
    )
  )
  
  # ==============================
  # UMAP 范围
  # ==============================
  x_range <- diff(range(df$UMAP_1))
  y_range <- diff(range(df$UMAP_2))
  
  # 坐标轴起点向右上移动
  x0 <- min(df$UMAP_1) + 0.06 * x_range
  y0 <- min(df$UMAP_2) + 0.06 * y_range
  
  ggplot(
    df,
    aes(x = UMAP_1, y = UMAP_2, color = Expression)
  ) +
    geom_point(size = 0.25) +
    
    # 浅灰 → 浅橙 → 粉色
    scale_color_gradientn(
      colors = c(
        "#D9D9D9",
        "#FDD49E",
        "#E7298A"
      ),
      limits = c(1, 1.8),
      oob = scales::squish,
      name = NULL
    ) +
    
    theme_void(base_size = 16) +
    
    coord_equal() +
    
    # ==============================
  # X 轴箭头
  # ==============================
  annotate(
    "segment",
    x = x0,
    y = y0,
    xend = x0 + 0.09 * x_range,
    yend = y0,
    arrow = arrow(length = unit(0.13, "cm")),
    linewidth = 0.45
  ) +
    
    # ==============================
  # Y 轴箭头
  # ==============================
  annotate(
    "segment",
    x = x0,
    y = y0,
    xend = x0,
    yend = y0 + 0.09 * y_range,
    arrow = arrow(length = unit(0.13, "cm")),
    linewidth = 0.45
  ) +
    
    # ==============================
  # X 轴标签
  # ==============================
  annotate(
    "text",
    x = x0 + 0.055 * x_range,
    y = y0 - 0.035 * y_range,
    label = "UMAP_1",
    size = 3.2
  ) +
    
    # ==============================
  # Y 轴标签
  # ==============================
  annotate(
    "text",
    x = x0 - 0.035 * x_range,
    y = y0 + 0.055 * y_range,
    label = "UMAP_2",
    angle = 90,
    size = 3.2
  ) +
    
    # ==============================
  # 基因名称
  # ==============================
  ggtitle(gene) +
    
    theme(
      plot.title = element_text(
        hjust = 0.5,
        size = 16,
        face = "bold"
      ),
      
      # 右侧 Expression 图例缩小
      legend.title = element_blank(),
      legend.text = element_text(size = 8)
    )
}


p_SOX4 <- plot_marker_umap("SOX4")

p_SOX6 <- plot_marker_umap("SOX6")

p_PTPRZ1 <- plot_marker_umap("PTPRZ1")

