    x = x0 + 0.055 * x_range,
    y = y0 - 0.035 * y_range,
    label = "UMAP_1",
    size = 3.2
  ) +
    
    # ==============================
  # Y 轴标签
  # ==============================
  annotate(
    "text",
    x = x0 - 0.035 * x_range,
    y = y0 + 0.055 * y_range,
    label = "UMAP_2",
    angle = 90,
    size = 3.2
  ) +
    
    # ==============================
  # 基因名称
  # ==============================
  ggtitle(gene) +
    
    theme(
      plot.title = element_text(
        hjust = 0.5,
        size = 16,
        face = "bold"
      ),
      legend.title = element_blank(),
      legend.text = element_text(size = 8)
    )
}

