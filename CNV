  new.scRNA,
  assay = "RNA",
  layer = "counts"
)

cnv_cells <- colnames(exprMatrix)

cellAnnota <- new.scRNA@meta.data[
  cnv_cells,
  c("cell_type", "L1_new", "Disease"),
  drop = FALSE
]

cellAnnota$infercnv_group <- NA_character_

# 正常细胞按照 L1_new 分类
normal_idx <- cellAnnota$cell_type == "Normal"

cellAnnota$infercnv_group[normal_idx] <- 
  as.character(cellAnnota$L1_new[normal_idx])


# 肿瘤细胞按照 Disease 分类
tumor_idx <- cellAnnota$cell_type == "Tumor"

cellAnnota$infercnv_group[tumor_idx] <- paste0(
  as.character(cellAnnota$Disease[tumor_idx]),
  "_Tumor"
)

group_order <- c(
  "B cell",
  "Endothelial",
  "Fibroblast/Mural",
  "Glial",
  "Myeloid",
  "T/NK",
  "GBM_Tumor",
  "BCBM_Tumor",
  "Melanoma-BM_Tumor",
  "NSCLC-BM_Tumor"
)

cellAnnota$infercnv_group <- factor(
  cellAnnota$infercnv_group,
  levels = group_order
)

cellAnnota_final <- data.frame(
  cell_group = as.character(cellAnnota$infercnv_group),
  row.names = rownames(cellAnnota)
)

identical(
  rownames(cellAnnota_final),
  colnames(exprMatrix)
)

reference_groups <- c(
  "B cell",
  "Endothelial",
  "Fibroblast/Mural",
  "Glial",
  "Myeloid",
  "T/NK"
)

infercnv_obj2 <- infercnv::CreateInfercnvObject(
  raw_counts_matrix = exprMatrix,
  annotations_file = cellAnnota_final,
  delim = "\t",
  gene_order_file = "human_hg38_gene_order_CNV.txt",
  ref_group_names = reference_groups
)

options(scipen = 100)

dir.create(
  "./output/cnv_4disease_celltype_disease/",
  recursive = TRUE,
  showWarnings = FALSE
)

infercnv_obj2 <- infercnv::run(
  infercnv_obj2,
  cutoff = 0.1,
