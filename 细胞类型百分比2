combined_new <- merge(
  data$GBM,
  y = list(
    data$BCBM,
    data$NSCLC_BM,
    data$Melanoma_BM
  ),
  add.cell.ids = c(
    "GBM",
    "BCBM",
    "NSCLC_BM",
    "Melanoma_BM"
  )
)


dim(combined_new)

table(combined_new$L1_reclassified, useNA = "ifany")

Reductions(combined_new)


DefaultAssay(combined_new) <- "RNA"

combined_new <- NormalizeData(
  combined_new,
  normalization.method = "LogNormalize",
  scale.factor = 10000,
  verbose = TRUE
)

combined_new <- FindVariableFeatures(
  combined_new,
  selection.method = "vst",
  nfeatures = 3000
)


combined_new <- ScaleData(
  combined_new,
  features = VariableFeatures(combined_new),
  verbose = TRUE
)
dim(GetAssayData(
  combined_new,
  assay = "RNA",
  layer = "scale.data"
))

combined_new <- RunPCA(
  combined_new,
  features = VariableFeatures(combined_new),
  npcs = 30,
  verbose = TRUE
)

dim(Embeddings(combined_new, "pca"))


library(harmony)
combined_new <- harmony::RunHarmony(
  object = combined_new,
  group.by.vars = "orig.ident",
  reduction.use = "pca",
  dims.use = 1:30,
  reduction.save = "harmony",
  project.dim = TRUE,
  verbose = TRUE
)

