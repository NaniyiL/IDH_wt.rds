combined_4disease_40GBM <- merge(
  x = gbm_40,
  y = list(
    BCBM_L1,
    NSCLC_L1,
    Melanoma_L1
  ),
  add.cell.ids = c(
    "GBM",
    "BCBM",
    "NSCLC",
    "Melanoma"
  ),
  project = "4Disease_L1"
)

DefaultAssay(combined_4disease_40GBM) <- "RNA"

combined_4disease_40GBM <- JoinLayers(
  combined_4disease_40GBM,
  assay = "RNA"
)

DefaultAssay(combined_4disease_40GBM) <- "RNA"

combined_4disease_40GBM <- NormalizeData(
  combined_4disease_40GBM,
  normalization.method = "LogNormalize",
  scale.factor = 10000,
  verbose = TRUE
)

combined_4disease_40GBM[["RNA"]]$data <- NULL
combined_4disease_40GBM[["RNA"]]$scale.data <- NULL

combined_4disease_40GBM <- NormalizeData(
  combined_4disease_40GBM,
  normalization.method = "LogNormalize",
  scale.factor = 10000
)

DefaultAssay(combined_4disease_40GBM) <- "RNA"

Layers(combined_4disease_40GBM[["RNA"]])

dim(combined_4disease_40GBM)

table(combined_4disease_40GBM$Disease, useNA = "ifany")
combined_4disease_40GBM <- FindVariableFeatures(
  combined_4disease_40GBM,
  selection.method = "vst",
  nfeatures = 3000
)

combined_4disease_40GBM <- ScaleData(
  combined_4disease_40GBM,
  features = VariableFeatures(combined_4disease_40GBM),
  verbose = TRUE
)

combined_4disease_40GBM <- RunPCA(
  combined_4disease_40GBM,
  features = VariableFeatures(combined_4disease_40GBM),
  npcs = 30,
  verbose = TRUE
)

library(harmony)
combined_4disease_40GBM <- harmony::RunHarmony(
  combined_4disease_40GBM,
  group.by.vars = "Disease",
  reduction.use = "pca",
  dims.use = 1:30,
  reduction.save = "harmony",
  project.dim = FALSE
)
Reductions(combined_4disease_40GBM)
dim(Embeddings(combined_4disease_40GBM, "harmony"))

combined_4disease_40GBM <- RunUMAP(
  combined_4disease_40GBM,
  reduction = "harmony",
  dims = 1:30,
  reduction.name = "umap_harmony",
  reduction.key = "UMAPH_"
)
